{
  "name": "@agentpass/sdk",
  "version": "0.1.1",
  "description": "AgentPass SDK — on-chain identity verification for AI agents (ERC-8004)",
  "repository": {
    "type": "git",
    "url": "https://github.com/echointheopen/agentpass.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/echointheopen/agentpass/issues"
  },
  "homepage": "https://useagentpass.com",
  "license": "MIT",
  "keywords": [
    "agentpass",
    "erc-8004",
    "on-chain",
    "identity",
    "base",
    "viem",
    "agent",
    "ai"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup src/index.ts --format esm,cjs && tsc --emitDeclarationOnly",
    "build:types": "tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "viem": "^2.48.4"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
